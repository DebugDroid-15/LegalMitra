# LegalMitra Environment Configuration
# Copy this file to .env and configure your credentials.

# NVIDIA Nemotron LLM Provider Credentials
NEMOTRON_API_KEY=nvapi-your-key-here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL_NAME=nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_API_FORMAT=openai_compatible
NEMOTRON_TIMEOUT_SECONDS=60.0

# Optional custom directory overrides
# RAW_DIR=data/01_raw
# NORMALIZED_DIR=data/02_normalized
# GENERATED_DIR=data/03_generated

