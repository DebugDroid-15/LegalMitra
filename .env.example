# LEGALMITRA ENVIRONMENT CONFIGURATION (STAGING & LOCAL TEMPLATE)
# Copy this file to .env and configure your credentials.
# NEVER commit real API keys or sensitive values to version control.

# --- LLM Provider Credentials ---
# NVIDIA NIM / NGC API endpoint credentials
NEMOTRON_API_KEY=nvapi-placeholder-secret-key
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
NEMOTRON_API_FORMAT=openai_compatible
NEMOTRON_TIMEOUT_SECONDS=60.0

# --- Web Service & Security ---
LEGALMITRA_ENV=staging
LEGALMITRA_HOST=127.0.0.1
LEGALMITRA_PORT=8000
RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database Storage Paths ---
LEGALMITRA_KB_PATH=data/legalmitra_kb.db
LEGALMITRA_CONV_PATH=data/conversations.db
